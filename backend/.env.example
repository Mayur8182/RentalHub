# ─── RentalHub Backend Environment Variables (Render Web Service) ───
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (Free M0 Cluster)
# Note: In Atlas, ensure Network Access whitelist allows 0.0.0.0/0 (anywhere)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/rentalhub?retryWrites=true&w=majority

# Secret key for signing JWT tokens (min 32 characters)
JWT_SECRET=your_super_strong_random_jwt_secret_key_at_least_32_chars

# Frontend URL for CORS (comma-separated if multiple, no trailing slashes)
# Example: https://rentalhub-frontend.onrender.com
FRONTEND_URL=https://rentalhub-frontend.onrender.com

